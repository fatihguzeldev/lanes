{
  "name": "lanes",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:deploy": "node scripts/prepare-deploy.mjs && vite build --mode deploy",
    "build:cloudflare": "node scripts/prepare-deploy.mjs && npm run check && vite build --mode deploy",
    "preview": "vite preview --host 127.0.0.1",
    "website:dev": "vite --config website/vite.config.ts",
    "website:typecheck": "tsc --noEmit -p website/tsconfig.json",
    "website:test": "vitest run website/src",
    "website:build": "npm run website:typecheck && vite build --config website/vite.config.ts",
    "website:preview": "vite preview --config website/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run check:boundaries && npm test && npm run build && npm run website:build",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc",
    "deploy": "npm run build:deploy && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/collision": "0.5.3",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@js-temporal/polyfill": "0.5.1",
    "fflate": "0.8.3",
    "jose": "6.2.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.156.2"
  }
}
